  if(!r.面接日時){const d=value('面接日'),t=value('面接時刻');if(/^\d{4}-\d{2}-\d{2}$/.test(d)&&/^\d{1,2}:\d{2}$/.test(t))r.面接日時=d+'T'+t.padStart(5,'0');}

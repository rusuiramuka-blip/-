function mailSeed_(){return [{"テンプレートID":"received","分類":"応募・面接","名称":"応募受付","件名":"【{{寺院名}}】巫女アルバイトのご応募を受け付けました","本文":"{{氏名}}様\n\nこのたびは、{{寺院名}}の{{募集年}}年正月巫女アルバイトにご応募いただき、ありがとうございます。\nご応募を受け付けました。\n\n面接は応募フォームで入力された日時にお越しください。当山から変更の電話がない場合は、ご入力の日時のままで結構です。\n日時が未定の場合や変更をご希望の場合は、このメールへの返信または電話でお知らせください。\n\n持参品：{{面接持参品}}\nご応募内容の訂正も、このメールへの返信でお知らせいただけます。\n\n――――――\n{{寺院名}}　巫女採用係\n電話：{{電話}}\n所在地：{{所在地}}","説明":"必要な方への受付連絡です。フォームの案内どおり来山される方への追加返信は必須ではありません。","対象":"応募／面接予定","記録区分":"応募連絡","有効":"true","並び順":10},{"テンプレートID":"interview","分類":"応募・面接","名称":"面接日時の確定","件名":"【{{寺院名}}】面接日時のお知らせ","本文":"{{氏名}}様\n\nこのたびは、当山の正月巫女アルバイトにご応募いただき、ありがとうございます。\n面接を下記の日時で行います。\n\n面接日時：{{面接日時}}\n場所：{{面接場所}}\n所在地：{{所在地}}\n所要時間：10〜15分程度\n持参物：{{面接持参品}}\n\n服装は自由です。開始時刻の5分前を目安にお越しいただき、本堂の受付で「巫女アルバイトの面接」とお伝えください。\nご都合に変更がなければ、ご返信は不要です。\n\n日時の変更をご希望の場合は、事前にお知らせください。当日の遅刻・欠席は、電話でご連絡をお願いいたします。\n\n――――――\n{{寺院名}}　巫女採用係\n電話：{{電話}}\n所在地：{{所在地}}","説明":"お寺側で日時を確定した方へ。持参物は必要なものだけ記入。","対象":"応募／面接予定","記録区分":"応募連絡","有効":"true","並び順":20},{"テンプレートID":"reschedule","分類":"応募・面接","名称":"面接日時の再調整","件名":"【{{寺院名}}】面接日時のご相談","本文":"{{氏名}}様\n\nこのたびは、当山の正月巫女アルバイトにご応募いただき、ありがとうございます。\nご希望いただいた日時での面接が難しいため、別の日時をご相談させてください。\n\n候補日時：\n{{面接候補日時}}\n\nご都合のよい日時を、第1希望・第2希望の順に、このメールへご返信ください。\n候補日時でのご来山が難しい場合は、別のご希望日時をお知らせください。\n\n返信期限：{{返信期限}}\n\nご返信を確認後、確定した日時を改めてご案内いたします。\nお手数をおかけしますが、よろしくお願いいたします。\n\n――――――\n{{寺院名}}　巫女採用係\n電話：{{電話}}\n所在地：{{所在地}}","説明":"提示した日時は候補です。返信を受けてから確定の案内を送ります。","対象":"応募／面接予定","記録区分":"応募連絡","有効":"true","並び順":30},{"テンプレートID":"reminder","分類":"応募・面接","名称":"面接前の確認","件名":"【{{寺院名}}】面接のご案内（確認）","本文":"{{氏名}}様\n\nお世話になっております。{{寺院名}} 巫女採用係です。\n面接の日が近づきましたので、改めてご案内いたします。\n\n面接日時：{{面接日時}}\n場所：{{面接場所}}\n持参物：{{面接持参品}}\n\n開始時刻の5分前を目安にお越しください。\nご都合に変更がなければ、ご返信は不要です。\n日時の変更は事前に、当日の遅刻・欠席は電話でお知らせください。\n\n当日お待ちしております。\n\n――――――\n{{寺院名}}　巫女採用係\n電話：{{電話}}\n所在地：{{所在地}}","説明":"確定済みの面接について、直前に案内する場合。","対象":"応募／面接予定","記録区分":"応募連絡","有効":"true","並び順":40},{"テンプレートID":"accepted","分類":"採否・研修","名称":"採用のご連絡","件名":"【{{寺院名}}】採用のご連絡","本文":"{{氏名}}様\n\nこのたびは、当山の正月巫女アルバイトにご応募いただき、ありがとうございました。\n選考の結果、{{募集年}}年正月の巫女アルバイトとして採用することとなりました。\n\n{{返信期限}}までに、このメールへの返信で、勤務をお引き受けいただけるかお知らせください。\n研修日時・勤務予定・勤務条件は、個別にご案内いたします。\n既にお返事をいただいている場合は、行き違いをご容赦ください。\n\nご不明な点や日程のご相談がございましたら、お知らせください。どうぞよろしくお願いいたします。\n\n――――――\n{{寺院名}}　巫女採用係\n電話：{{電話}}\n所在地：{{所在地}}","説明":"採用決定後、まだ本人に伝えていない場合に使用。その場で口頭で伝えた方には不要です。","対象":"採用","記録区分":"採用連絡","有効":"true","並び順":50},{"テンプレートID":"training","分類":"採否・研修","名称":"研修のご案内","件名":"【{{寺院名}}】研修のご案内","本文":"{{氏名}}様\n\nお世話になっております。{{寺院名}} 巫女採用係です。\n研修について、下記のとおりご案内いたします。\n\n日時：{{研修日時}}\n集合場所：{{集合場所}}\n持参物：{{研修の持参物}}\n服装：{{研修時の服装}}\n\nご不明な点や、ご案内した日時に参加できない場合は、お早めにお知らせください。\n当日の遅刻・欠席は電話でご連絡ください。\n\n――――――\n{{寺院名}}　巫女採用係\n電話：{{電話}}\n所在地：{{所在地}}","説明":"口頭で採用を伝えた方にも使える、研修だけの案内です。","対象":"採用","記録区分":"その他","有効":"true","並び順":55},{"テンプレートID":"rejected","分類":"採否・研修","名称":"選考結果（不採用）","件名":"【{{寺院名}}】選考結果のご連絡","本文":"{{氏名}}様\n\nこのたびは、当山の正月巫女アルバイトにご応募いただき、ありがとうございました。\n\n慎重に選考いたしました結果、誠に恐縮ながら、今回は採用を見送らせていただくこととなりました。\nご希望に沿えず申し訳ございません。\n\n当山にご関心をお寄せいただき、選考にお時間をいただきましたことに、心より御礼申し上げます。\n末筆ながら、今後のご健勝とご活躍をお祈りいたします。\n\n――――――\n{{寺院名}}　巫女採用係\n電話：{{電話}}\n所在地：{{所在地}}","説明":"不採用を決定済みの方へ。面接の有無にかかわらず使用できます。","対象":"不採用","記録区分":"不採用連絡","有効":"true","並び順":60},{"テンプレートID":"prework","分類":"採否・研修","名称":"勤務前の確認依頼","件名":"【{{寺院名}}】勤務前の確認のお願い","本文":"{{氏名}}様\n\nお世話になっております。{{寺院名}} 巫女採用係です。\n勤務前の準備のため、ご案内した研修・勤務予定について、{{回答期限}}までにこのメールへ「確認しました」とご返信ください。\n\n確認していただく内容：\n{{確認事項}}\n\n認識と異なる点や勤務できない日時がある場合は、あわせてお知らせください。\n既にご回答いただいている場合は、行き違いをご容赦ください。\n\n――――――\n{{寺院名}}　巫女採用係\n電話：{{電話}}\n所在地：{{所在地}}","説明":"案内済みの内容を本人に確認してもらう文面です。返信は職員が確認します。","対象":"採用","記録区分":"その他","有効":"true","並び順":70},{"テンプレートID":"shift","分類":"勤務の案内","名称":"勤務予定のご案内","件名":"【{{寺院名}}】勤務シフトのご案内","本文":"{{氏名}}様\n\nお世話になっております。{{寺院名}} 巫女採用係です。\n現在の勤務予定をご案内いたします。\n\n{{勤務予定}}\n\n{{確認期限}}までに、このメールへ「確認しました」とご返信ください。\n認識と異なる点や勤務が難しい日時がありましたら、あわせてお知らせください。\n勤務当日の遅刻・欠席は、電話でご連絡ください。\n\n――――――\n{{寺院名}}　巫女採用係\n電話：{{電話}}\n所在地：{{所在地}}","説明":"新しい台帳の本人の配置から、勤務日時・売場・休憩・食事を本文に入れます。","対象":"採用","記録区分":"その他","有効":"true","並び順":80},{"テンプレートID":"vacancy","分類":"勤務の案内","名称":"空きシフトの追加募集","件名":"【{{寺院名}}】追加勤務の募集について","本文":"{{氏名}}様\n\nお世話になっております。{{寺院名}} 巫女採用係です。\n下記の日程で、追加勤務が可能な方を募集いたします。\n\n募集する勤務：\n{{募集する勤務の日時・売場・人数}}\n\n応募締切：{{応募締切}}\n結果のご連絡予定：{{結果連絡予定日}}\n\n勤務を希望される方は、可能な日時をこのメールへご返信ください。ご希望を確認し、当山で配置を調整します。\n応募時点では勤務確定にはなりません。当山からの確定連絡をお待ちください。\n追加勤務のご希望がない場合は、返信不要です。\n\n――――――\n{{寺院名}}　巫女採用係\n電話：{{電話}}\n所在地：{{所在地}}","説明":"追加勤務の希望をメールで受け、お寺で調整する場合の文面です。送信だけでシフトは確定しません。","対象":"採用","記録区分":"その他","有効":"true","並び順":90},{"テンプレートID":"vacancy_selected","分類":"勤務の案内","名称":"追加勤務の確定","件名":"【{{寺院名}}】追加勤務の確定のお知らせ","本文":"{{氏名}}様\n\n追加勤務にご応募いただき、ありがとうございます。\n調整の結果、下記の勤務をお願いすることとなりました。\n\n勤務日時：{{追加勤務日時}}\n売場・集合場所：{{売場・集合場所}}\n休憩・食事等：{{休憩・食事等の案内}}\n\nご案内した日時・場所をご確認ください。\n\n{{確認期限}}までに、このメールへ「確認しました」とご返信ください。\nご都合が変わった場合は、お早めにお知らせください。\nどうぞよろしくお願いいたします。\n\n――――――\n{{寺院名}}　巫女採用係\n電話：{{電話}}\n所在地：{{所在地}}","説明":"シフトへ登録し本人と調整した後に使用します。文面作成や送信記録では配置は変更しません。","対象":"採用","記録区分":"その他","有効":"true","並び順":100},{"テンプレートID":"vacancy_notselected","分類":"勤務の案内","名称":"追加勤務の見送り","件名":"【{{寺院名}}】追加勤務の調整結果について","本文":"{{氏名}}様\n\n追加勤務にご応募いただき、ありがとうございます。\n{{応募した追加勤務}}について配置を調整した結果、今回は追加の勤務をお願いしないこととなりました。\n\n既に確定している勤務シフトに変更はありません。\nご協力のお申し出に感謝申し上げます。\n引き続き、どうぞよろしくお願いいたします。\n\n――――――\n{{寺院名}}　巫女採用係\n電話：{{電話}}\n所在地：{{所在地}}","説明":"今回応募した追加枠の結果です。採用自体の取消と混同しない文面。","対象":"採用","記録区分":"その他","有効":"true","並び順":110},{"テンプレートID":"returning","分類":"その他","名称":"経験者への募集案内","件名":"【{{寺院名}}】{{募集年}}年正月 巫女アルバイトのご案内","本文":"{{氏名}}様\n\nこれまで当山の行事にお力添えいただき、ありがとうございます。\n{{募集年}}年正月の巫女アルバイトを募集いたします。\n今年もご都合がよろしければ、下記の募集内容をご確認のうえ、お申し込みください。\n\n募集内容・応募フォーム：\n{{応募フォームURL}}\n\n応募期限：{{応募期限}}\n\n1月3日までは原則として出勤をお願いしています。1月4日以降は、希望者の中から必要な人数を当山で調整し、個別に勤務をお願いします。\n勤務可能な日時は、応募フォームでお知らせください。\n\nご友人が応募される場合も、お一人ずつフォームからお申し込みください。\n既にお申し込みいただいている場合は、行き違いをご容赦ください。\n\n――――――\n{{寺院名}}　巫女採用係\n電話：{{電話}}\n所在地：{{所在地}}","説明":"募集開始後、案内を送る対象者を確認して使用。","対象":"","記録区分":"その他","有効":"true","並び順":120},{"テンプレートID":"withdrawal","分類":"その他","名称":"応募辞退の受付","件名":"【{{寺院名}}】応募辞退のご連絡を承りました","本文":"{{氏名}}様\n\nご連絡いただき、ありがとうございます。\n正月巫女アルバイトの応募辞退について、承りました。\n\nこのたびは当山にご関心をお寄せいただき、ありがとうございました。\nまたご縁がございましたら、どうぞよろしくお願いいたします。\n\n――――――\n{{寺院名}}　巫女採用係\n電話：{{電話}}\n所在地：{{所在地}}","説明":"ご本人から辞退の連絡を受けた後に使用。","対象":"辞退","記録区分":"その他","有効":"true","並び順":130}];}

function upgradeMail(){
  const lock=LockService.getScriptLock();lock.waitLock(30000);try{
    const s=state_();auth_(s,true);const b=db_();
    ['メール文面','連絡記録'].forEach(name=>{if(b.getSheetByName(name))return;const sh=b.insertSheet(name),h=headers_(name);sh.getRange(1,1,1,h.length).setValues([h]).setBackground('#285b49').setFontColor('#ffffff').setFontWeight('bold');sh.setFrozenRows(1);sh.setColumnWidths(1,h.length,170);sh.getRange(2,1,sh.getMaxRows()-1,h.length).setNumberFormat('@');});
    if(!s.メール文面.length)write_('メール文面',mailSeed_());
    protectPaid_(state_());console.log('メール文面と連絡記録を準備しました。共通情報は画面で設定してください。');
  }finally{lock.releaseLock();}
}

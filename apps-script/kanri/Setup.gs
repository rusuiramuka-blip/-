/* 移行専用：旧シートの確定済みの最終行だけを読み、新しい普通の行へ変換する。 */
function oldRows_(book,name){const sh=book.getSheetByName(name);return sh&&sh.getLastRow()>1?sh.getDataRange().getValues().slice(1):[];}
function oldState_(book){
  const commits={};oldRows_(book,'_変更履歴').forEach(r=>{if(r[2]==='BEGIN')throw Error('旧台帳に未完了の保存があります。');if(r[2]==='COMMITTED')commits[r[0]]=Number(r[1]);});
  const out={};['_設定','01_人物','02_応募採用','03_時給交通費','05_勤務希望','04_必要人数','11_運用設定'].forEach(t=>{const last={};oldRows_(book,t).forEach(r=>{if(commits[r[0]]===Number(r[1]))last[r[2]]=r;});out[t]=Object.values(last);});return out;
}
function flatten_(x,prefix){if(x==null)return '';if(typeof x!=='object')return (prefix?prefix+'：':'')+String(x);return Object.keys(x).map(k=>flatten_(x[k],(prefix?prefix+' / ':'')+k)).filter(Boolean).join('\n');}

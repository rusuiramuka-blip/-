function initSheets_(book){
  Object.keys(COLS).forEach((name,i)=>{
    let sh=book.getSheetByName(name);if(!sh)sh=i===0&&book.getSheets().length===1?book.getSheets()[0].setName(name):book.insertSheet(name);
    const h=headers_(name);if(sh.getMaxColumns()<h.length)sh.insertColumnsAfter(sh.getMaxColumns(),h.length-sh.getMaxColumns());
    sh.getRange(1,1,1,h.length).setValues([h]);sh.setFrozenRows(1);sh.getRange(1,1,1,h.length).setBackground('#285b49').setFontColor('#ffffff').setFontWeight('bold');
    sh.setColumnWidths(1,h.length,150);sh.setRowHeight(1,32);sh.getRange(2,1,sh.getMaxRows()-1,h.length).setNumberFormat('@');
  });
}
function formatSheets_(b){

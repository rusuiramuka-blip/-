function receiveResponses_(s,responses){
  const seen=new Set(s.フォーム回答.map(r=>r.回答ID));
  responses.forEach(resp=>{const rid=resp.getId();if(seen.has(rid))return;const ans={};resp.getItemResponses().forEach(x=>{const v=x.getResponse();ans[x.getItem().getTitle()]=Array.isArray(v)?v.join('、'):String(v);});
    const r=clean_('フォーム回答',{回答ID:rid,受付日時:Utilities.formatDate(resp.getTimestamp(),'Asia/Tokyo',"yyyy-MM-dd'T'HH:mm"),...formFields_(s,ans)});s.フォーム回答.push(r);seen.add(rid);
  });
  // 移行済みの応募者は回答IDで結び直す。面接記録・採否は書き換えない。
  s.フォーム回答.forEach(r=>{const p=s.人.find(p=>p.回答ID===r.回答ID);if(p)r.人ID=p.人ID;});
  write_('フォーム回答',s.フォーム回答);
}
function receptionSetting_(s,key,value){let r=s.設定.find(r=>r.項目===key);if(!r){r={項目:key,値:value,説明:''};s.設定.push(r);}r.値=value;s.cfg[key]=value;}
function pullResponses_(s){

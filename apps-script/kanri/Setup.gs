// 確認期間の受信。フォームの質問・受付状態・既存の回答先には触れない。
function connectReception(){
  const lock=LockService.getScriptLock();lock.waitLock(30000);
  try{const s=state_();auth_(s,true);if(!s.cfg.応募フォームID||!s.cfg['フォーム項目:氏名'])throw Error('フォームIDと質問の対応を設定してください。');
    const form=FormApp.openById(String(s.cfg.応募フォームID));pullResponses_(s);
    const exists=ScriptApp.getProjectTriggers().some(t=>t.getHandlerFunction()==='onApplicationSubmit'&&t.getTriggerSourceId()===form.getId());
    if(!exists)ScriptApp.newTrigger('onApplicationSubmit').forForm(form).onFormSubmit().create();
    receptionSetting_(s,'応募受信方式','並行確認');write_('設定',s.設定);console.log('応募の自動受信を設定しました。旧版の受付は継続しています。');
  }finally{lock.releaseLock();}
}
function upgradeInterview(){
  const s=PropertiesService.getScriptProperties();if(Session.getActiveUser().getEmail()!==s.getProperty('管理者'))throw Error('管理者で実行してください。');
  const sh=db_().getSheetByName('人'),h=headers_('人'),old=sh.getRange(1,1,1,29).getValues()[0];
  if(old.join('|')!==h.slice(0,29).join('|'))throw Error('列を確認してください。');
  if(sh.getMaxColumns()<h.length)sh.insertColumnsAfter(sh.getMaxColumns(),h.length-sh.getMaxColumns());
  sh.getRange(1,30,1,h.length-29).setValues([h.slice(29)]).setBackground('#285b49').setFontColor('#ffffff').setFontWeight('bold');
  sh.getRange(2,30,sh.getMaxRows()-1,h.length-29).setNumberFormat('@');sh.setColumnWidths(30,h.length-29,180);
}
function onApplicationSubmit(e){
